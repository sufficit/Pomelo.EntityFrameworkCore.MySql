<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AssemblyName>Pomelo.EntityFrameworkCore.MySql</AssemblyName>
    <RootNamespace>Pomelo.EntityFrameworkCore.MySql</RootNamespace>
    <Version>3.2.8.1</Version>
    <AssemblyVersion>3.2.7.0</AssemblyVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../Pomelo.snk</AssemblyOriginatorKeyFile>
    <PackageId>Pomelo.EntityFrameworkCore.MySql</PackageId>
    <Authors>Pomelo Foundation; Sufficit</Authors>
    <Description>EF Core 3.1 provider maintained by Sufficit for netstandard2.0 with MySqlConnector 2.6.1.</Description>
    <RepositoryUrl>https://github.com/sufficit/Pomelo.EntityFrameworkCore.MySql</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PythonExecutable Condition="'$(PythonExecutable)' == ''">python3</PythonExecutable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[3.1.32,4.0.0)" />
    <PackageReference Include="MySqlConnector" Version="[2.6.1,3.0.0)" />
    <PackageReference Include="Pomelo.JsonObject" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="prepare.py" Pack="true" PackagePath="source/" />
  </ItemGroup>
  <Target Name="PrepareCompatibilityProvider" BeforeTargets="AssignTargetPaths">
    <Exec Command="&quot;$(PythonExecutable)&quot; &quot;$(MSBuildProjectDirectory)/prepare.py&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)frozen&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)frozen/src/**/*.cs" />
      <EmbeddedResource Include="$(IntermediateOutputPath)frozen/src/EFCore.MySql/Properties/MySqlStrings.resx" LogicalName="Pomelo.EntityFrameworkCore.MySql.Properties.MySqlStrings.resources" />
    </ItemGroup>
  </Target>
</Project>
